{
  "name": "lego-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An independent 3D brick system and assembly explorer.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs && node scripts/validate-skills.mjs",
    "test:skills": "node scripts/validate-skills.mjs",
    "agent:plan": "node scripts/agent-plan.mjs",
    "agent:validate": "node scripts/agent-validate.mjs",
    "registry:lock": "node scripts/lock-skills.mjs --write",
    "world:run": "node adapters/cli/world.mjs",
    "world:mcp": "node adapters/mcp/server.mjs",
    "world:pipeline": "node adapters/cli/world.mjs pipeline"
  },
  "dependencies": {
    "three": "0.180.0",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "vite": "7.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
