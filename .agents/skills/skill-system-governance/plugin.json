{
  "manifestVersion": "world-plugin/v1",
  "id": "skill-system-governance",
  "version": "1.0.0",
  "owner": "first-party",
  "skillPath": ".agents/skills/skill-system-governance/SKILL.md",
  "domain": "skill",
