{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1998x-stack.github.io/LEGO-Worlds/schemas/plugin-manifest.schema.json",
  "title": "PluginManifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "version",
    "owner",
    "skillPath",
    "domain",
    "stage",
    "execution",
    "capabilities",
    "dependsOn",
    "permissions",
    "validationGates"
  ],
  "properties": {
    "manifestVersion": {
      "const": "world-plugin/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": {
      "enum": [
        "first-party"
      ]
    },
    "skillPath": {
      "type": "string",
      "pattern": "^\\.agents/skills/"
    },
    "domain": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "adapter"
      ],
      "properties": {
        "mode": {
          "enum": [
            "builtin",
            "guidance-only"
          ]
        },
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "requiresLevel",
          "producesKind",
          "readiness",
          "inputSchema",
          "outputSchema"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "plan",
              "build",
              "validate",
              "repair",
              "export"
            ]
          },
          "requiresLevel": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2"
            ]
          },
          "producesKind": {
            "type": "string"
          },
          "readiness": {
            "enum": [
              "available",
              "guidance-only"
            ]
          },
          "inputSchema": {
            "const": "schemas/tool-request.schema.json"
          },
          "outputSchema": {
            "const": "schemas/tool-result.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object",
      "required": [
        "network",
        "subprocess",
        "filesystem"
      ],
      "properties": {
        "network": {
          "const": false
        },
        "subprocess": {
          "const": false
        },
        "filesystem": {
          "type": "object",
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validationGates": {
      "type": "object",
      "required": [
        "L0",
        "L1",
        "L2"
      ],
      "properties": {
        "L0": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "L1": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "L2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
