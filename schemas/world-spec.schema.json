{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1998x-stack.github.io/LEGO-Worlds/schemas/world-spec.schema.json",
  "title": "WorldSpec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "domain",
    "prompt",
    "targetLevel",
    "requirements",
    "assumptions",
    "unresolved",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "world-spec/v1"
    },
    "kind": {
      "const": "WorldSpec"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "domain": {
      "enum": [
        "robotics",
        "mechanisms",
        "built-environment",
        "aerospace",
        "unknown"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "targetLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "property",
          "operator",
          "value",
          "priority",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "property": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "operator": {
            "enum": [
              "eq",
              "gte",
              "lte",
              "include",
              "describe"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 30
          },
          "priority": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "source": {
            "enum": [
              "user",
              "assumption",
              "derived"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "generator",
        "source"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
